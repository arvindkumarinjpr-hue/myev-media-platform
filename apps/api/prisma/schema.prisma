// Module 1A: datasource and generator wired only.
// Business tables (users, workspaces, etc.) are added in Module 1B / 1C
// per the approved Module 1 Engineering Plan — intentionally empty here.

generator client {
  provider = "prisma-client-js"
  // Custom output path (Module 1A.1 hardening): decouples the generated
  // client from pnpm's hashed virtual-store path, which otherwise differs
  // between a full (dev+prod) install and a --prod-only install — making it
  // unsafe to copy the generated client between Docker build stages.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
