// Module 1B.1: Identity & Access Core.
// Module 1C: Workspace Foundation — workspaces, membership, invitations,
// projects, slug reservations, Platform Owner. See MODULE_1C_ENGINEERING
// PLAN — IMPLEMENTATION-READY FINAL for the design this schema implements.
//
// Slug uniqueness/history (workspaces.slug, projects.slug) is intentionally
// NOT expressed here as a `@unique` — Prisma's schema DSL cannot represent
// the deferred composite foreign keys or partial unique indexes this design
// requires (see prisma/migrations/<ts>_workspace_core/migration.sql and
// .../platform_owner_flag/migration.sql for the hand-written raw SQL that
// adds them after Prisma's generated CREATE TABLE statements).

generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  // Module 7 Phase 7.7 staging deployment: the render-worker's runtime
  // stage (node:24-bookworm-slim) crashed at boot —
  // PrismaClientInitializationError, "Query Engine for runtime
  // debian-openssl-3.0.x" not found, because `prisma generate` inside
  // the render-worker Dockerfile's OWN bookworm-slim `build` stage
  // resolved the implicit "native" target to debian-openssl-1.1.x (a
  // generate-time detection quirk, not a real base-image mismatch — the
  // build and runtime stages use the identical node:24-bookworm-slim
  // tag). api/worker never hit this (node:24-alpine -> "native"
  // correctly resolves to the musl target both at generate- and
  // run-time). Bundling debian-openssl-3.0.x explicitly, alongside
  // whatever "native" resolves to, makes this correct regardless of the
  // generating platform's detection.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum SessionStatus {
  ACTIVE
  ROTATED
  REVOKED
  EXPIRED
}

enum RevokedReason {
  LOGOUT
  PASSWORD_CHANGE
  PASSWORD_RESET
  ADMIN_LOCK
  REUSE_DETECTED
  EXPIRED
}

enum TokenPurpose {
  PASSWORD_RESET
  ACCOUNT_ACTIVATION
}

enum TokenActionStatus {
  PENDING
  USED
  EXPIRED
  INVALIDATED
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum WorkspaceMemberStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  REMOVED
}

enum WorkspaceInvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

// Module 1D: PENDING_UPLOAD/VERIFYING are transient — no direct DELETE
// transition (see MODULE 1D ENGINEERING PLAN — FINAL APPROVAL CANDIDATE §3
// lifecycle table). VERIFICATION_FAILED is the dedicated retryable state
// (Safeguard 2) — deliberately distinct from REJECTED, which stays
// terminal. QUARANTINED is reachable only via a real malware-scan
// INFECTED result; the shipped NullMalwareScanProvider never produces one.
enum MediaAssetStatus {
  PENDING_UPLOAD
  VERIFYING
  ACTIVE
  REJECTED
  QUARANTINED
  VERIFICATION_FAILED
  ARCHIVED
  DELETED
}

enum MediaAssetType {
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  // Module 7 Phase 7.4 — generated caption/subtitle documents (SRT/VTT).
  SUBTITLE
}

// Module 7 Phase 7.4 — Media Generation. The image/voice/subtitle
// analogue of MediaJobOperation's text sibling. One polymorphic
// media_jobs table discriminated by this enum (mirrors how a single
// ai_jobs table serves every agent identifier) rather than one table per
// family.
enum MediaJobOperation {
  IMAGE_GENERATE
  TTS
  SUBTITLE_GENERATE
}

// Module 7 Phase 7.4 — identical vocabulary to AiJobStatus / the frozen
// FRD §24 Job Status enum. Reused, not re-invented.
enum MediaJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

// Independent of MediaAssetStatus by design — see MODULE 1D ENGINEERING
// PLAN §6 "Malware-Scan Semantics": status answers "is this usable right
// now", this answers "was this actually checked, and what was found".
// NullMalwareScanProvider (the only implementation shipped in Module 1D)
// only ever produces NOT_SCANNED — never CLEAN.
enum MalwareScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
  SCAN_FAILED
}

// Records which real-world storage service actually holds a given row's
// bytes — a historical fact per row, independent of which StorageProvider
// CODE implementation is active today. See MODULE 1D ENGINEERING PLAN §7.
enum MediaStorageProviderIdentity {
  MINIO
  AWS_S3
  CLOUDFLARE_R2
  OTHER_S3_COMPATIBLE
}

// Only WORKSPACE_PRIVATE is ever set or read by any Module 1D code path —
// reserved now so a future public-sharing feature doesn't require a
// migration just to introduce the concept. See MODULE 1D ENGINEERING PLAN
// §6 entity model.
enum MediaAssetVisibility {
  WORKSPACE_PRIVATE
}

// Module 1E: Content Foundation. Six values per the frozen DB Entity
// Design doc §5.4 — Module 1E's own creation endpoint only accepts
// BLOG/VIDEO; the other four exist for forward compatibility, same
// pattern as Module 1D keeping unused MediaStorageProviderIdentity values.
enum ContentType {
  BLOG
  VIDEO
  SHORT
  REEL
  NEWSLETTER
  SOCIAL_POST
}

// Module 1E-driven editorial states: DRAFT, IN_PROGRESS, REVIEW, APPROVED,
// ARCHIVED, DELETED. RENDERING/FAILED/SCHEDULED/PUBLISHED are reserved —
// no Module 1E code path ever sets them; they exist only because the
// frozen FRD §24.5/24.6 vocabulary requires them for schema completeness.
// See MODULE 1E ENGINEERING PLAN for the full state machine and why
// Video's real Rendering requirement is deliberately simplified here.
enum ContentItemStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  APPROVED
  ARCHIVED
  DELETED
  RENDERING
  FAILED
  SCHEDULED
  PUBLISHED
}

// Module 7 Phase 7.1 — the frozen Video Automation Engine "Supported
// Outputs" list (VIDEO_AUTOMATION_ENGINE_V1.0.md) and FR-VID-001 ("Target
// platform required. Missing platform → 400"). A closed set: the video
// pipeline never renders to a platform outside this list. YouTube
// Shorts / Instagram Reel / Facebook Reel are captured here as the
// target platform/format of a single VIDEO content item — Module 1E only
// grants BLOG/VIDEO permission families, so SHORT/REEL are not separate
// content types in this phase (see MODULE 7 PHASE 7.1 report, §20).
enum VideoTargetPlatform {
  YOUTUBE_LONG
  YOUTUBE_SHORTS
  INSTAGRAM_REEL
  FACEBOOK_REEL
  SQUARE_SOCIAL
  LANDSCAPE_PRESENTATION
}

enum ContentReviewAction {
  SUBMITTED
  APPROVED
  REJECTED
}

// Module 1F: System Services Foundation. The 9 categories from the frozen
// QUEUE_AND_BACKGROUND_JOB_ENGINE_V1.0.md §3, verbatim — a closed set,
// never a free string. Many job types multiplex within one category queue
// via BullMQ's own job.name field; this column is the category, not the
// job type. Module 1F itself only registers real processors for
// MAINTENANCE/SYSTEM — the other 7 exist so future modules can enqueue
// into them immediately without redefining the category.
enum QueueName {
  CRITICAL
  REALTIME
  AI
  MEDIA
  PUBLISHING
  ANALYTICS
  MAINTENANCE
  NOTIFICATION
  SYSTEM
}

// Module 1F: exactly FRD Appendix A's frozen 5-value Job Status enum,
// reused verbatim — the same enum ai_jobs uses (DB Design §24.8), since
// background_jobs is the same category of generic-execution entity, not
// publishing_jobs' richer domain-specific one. CANCELLED/SCHEDULED/
// RETRYING/DEAD_LETTERED are deliberately NOT added here — see the
// BackgroundJob model comment for how each is represented instead,
// without extending this frozen enum (would require an ACR).
enum BackgroundJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  TOKEN_REFRESHED
  TOKEN_REUSE_DETECTED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  PASSWORD_CHANGED
  ACCOUNT_LOCKED
  USER_CREATED
  ACCOUNT_ACTIVATED
  ACCOUNT_ACTIVATION_TOKEN_ROTATED
  WORKSPACE_CREATED
  WORKSPACE_SETTINGS_UPDATED
  WORKSPACE_ARCHIVED
  WORKSPACE_RESTORED
  WORKSPACE_DELETED
  WORKSPACE_OWNERSHIP_TRANSFERRED
  WORKSPACE_INVITATION_CREATED
  WORKSPACE_INVITATION_REVOKED
  WORKSPACE_MEMBER_PENDING_ACTIVATION
  WORKSPACE_MEMBER_JOINED
  WORKSPACE_MEMBER_ACTIVATED
  WORKSPACE_MEMBER_ROLE_CHANGED
  WORKSPACE_MEMBER_SUSPENDED
  WORKSPACE_MEMBER_REMOVED
  WORKSPACE_MEMBER_LEFT
  WORKSPACE_MEMBER_ACTIVATION_RESENT
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_ARCHIVED
  PROJECT_RESTORED
  // Module 2 Phase 2.1 (ACR-014): schema-level only in this phase — no
  // application code writes these yet. Wired by the Phase 2.2/2.3
  // service layer.
  KNOWLEDGE_PACK_CREATED
  KNOWLEDGE_PACK_UPDATED
  KNOWLEDGE_PACK_VALIDATION_REJECTED
  KNOWLEDGE_PACK_ACTIVATED
  KNOWLEDGE_PACK_ARCHIVED
  KNOWLEDGE_PACK_DELETED
  MEDIA_ASSET_UPLOAD_INTENT_CREATED
  MEDIA_ASSET_VERIFICATION_CLAIMED
  MEDIA_ASSET_ACTIVATED
  MEDIA_ASSET_REJECTED
  MEDIA_ASSET_QUARANTINED
  MEDIA_ASSET_VERIFICATION_FAILED
  MEDIA_ASSET_VERIFICATION_RETRIED
  MEDIA_ASSET_VERSION_REPLACEMENT_STARTED
  MEDIA_ASSET_ARCHIVED
  MEDIA_ASSET_RESTORED
  MEDIA_ASSET_DELETED
  MEDIA_ASSET_METADATA_UPDATED
  MEDIA_ASSET_DOWNLOAD_URL_ISSUED
  CONTENT_ITEM_CREATED
  CONTENT_ITEM_UPDATED
  CONTENT_VERSION_CREATED
  CONTENT_ITEM_STARTED
  CONTENT_ITEM_SUBMITTED_FOR_REVIEW
  CONTENT_ITEM_APPROVED
  CONTENT_ITEM_REJECTED
  CONTENT_ITEM_ARCHIVED
  CONTENT_ITEM_RESTORED
  CONTENT_ITEM_DELETED
  CONTENT_ITEM_SERIES_CHANGED
  CONTENT_SERIES_CREATED
  CONTENT_SERIES_UPDATED
  CONTENT_SERIES_DELETED
  // Module 1F: only user-initiated actions on a background job are
  // audited — a job silently completing/failing on its own has no human
  // actor and is operational telemetry (job_history + structured logs),
  // not a business event, mirroring exactly the reasoning already applied
  // to distributed-lock events (never audited either). Webhook/
  // notification audit actions are added in their own later migrations,
  // when those tables exist.
  JOB_CANCELLATION_REQUESTED
  JOB_CANCELLED
  JOB_RETRY_REQUESTED
  // Module 1F Milestone 7 (Scheduler Foundation), Revision 3 §11: only
  // user-initiated CRUD on a schedule's own definition is audited — the
  // per-occurrence firing of a schedule (SCHEDULE_TRIGGERED/SKIPPED, and
  // the system-initiated auto-disable on a permanently-invalid schedule
  // definition, §7) is deliberately excluded, mirroring the identical
  // reasoning already applied to background jobs above: no human actor,
  // operational telemetry (structured logs + the resulting
  // background_jobs/job_history trail), not a business event.
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_ENABLED
  SCHEDULE_DISABLED
  SCHEDULE_DELETED
  // Module 3 Phase 3.2: only the moment of triggering intent is audited,
  // mirroring JOB_CANCELLATION_REQUESTED/SCHEDULE_TRIGGERED's identical
  // reasoning above — a job's own completion/failure is operational
  // telemetry, fully captured in ai_jobs.status + ai_job_steps, not a
  // second business event.
  AI_EXECUTION_REQUESTED
  // Module 5 Phase 5.1: the moment of promoting a Research-derived
  // keyword cluster into a real Topic Cluster — a deliberate human
  // planning decision, mirroring AI_EXECUTION_REQUESTED's own "audit the
  // triggering intent" reasoning above.
  TOPIC_CLUSTER_CREATED
  // Module 8 Phase 8.1: internal-linking recommendation persistence
  // events. One generic status-change action (mirrors CONTENT_ITEM_UPDATED's
  // own generic-action-plus-afterState-diff style) rather than one enum
  // value per transition — GENERATED/ACCEPTED/REJECTED/STALE are all
  // captured in the event's afterState, not the action name itself.
  INTERNAL_LINK_CREATED
  INTERNAL_LINK_STATUS_CHANGED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  publicId     String     @unique @default(uuid()) @map("public_id") @db.Uuid
  email        String     @unique
  passwordHash String?    @map("password_hash")
  fullName     String     @map("full_name")
  status       UserStatus @default(PENDING_ACTIVATION)

  // Module 1C: a single, global, platform-level authority flag — distinct
  // from the workspace-scoped "Owner" role. Uniqueness (at most one
  // non-deleted user) is enforced by a partial unique index added via raw
  // SQL (see prisma/migrations/<ts>_platform_owner_flag/migration.sql),
  // not by this column alone. Never set by any application code path other
  // than the serialized bootstrap seed — see PlatformOwnerService.
  isPlatformOwner Boolean @default(false) @map("is_platform_owner")

  createdById  String? @map("created_by") @db.Uuid
  createdBy    User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers User[]  @relation("UserCreatedBy")

  activatedAt DateTime? @map("activated_at")
  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  passwordHistory UserPasswordHistory[]
  sessions        UserSession[]
  actionTokens    UserActionToken[]
  auditLogs       AuditLog[]

  ownedWorkspaces        Workspace[]           @relation("WorkspaceOwner")
  createdWorkspaces      Workspace[]           @relation("WorkspaceCreatedBy")
  workspaceMemberships   WorkspaceMember[]     @relation("WorkspaceMemberUser")
  memberInvitesSent      WorkspaceMember[]     @relation("WorkspaceMemberInvitedBy")
  invitationsSent        WorkspaceInvitation[] @relation("InvitationInvitedBy")
  invitationsReceived    WorkspaceInvitation[] @relation("InvitationInvitedUser")
  invitationsAccepted    WorkspaceInvitation[] @relation("InvitationAcceptedBy")
  ownedProjects          Project[]             @relation("ProjectOwner")
  createdProjects        Project[]             @relation("ProjectCreatedBy")
  createdMediaAssets     MediaAsset[]          @relation("MediaAssetCreatedBy")
  createdContentItems    ContentItem[]         @relation("ContentItemCreatedBy")
  createdContentVersions ContentVersion[]      @relation("ContentVersionCreatedBy")
  createdContentSeries   ContentSeries[]       @relation("ContentSeriesCreatedBy")
  contentReviewEvents    ContentReviewEvent[]
  createdBackgroundJobs  BackgroundJob[]       @relation("BackgroundJobCreatedBy")
  createdScheduledJobs   ScheduledJob[]        @relation("ScheduledJobCreatedBy")
  updatedScheduledJobs   ScheduledJob[]        @relation("ScheduledJobUpdatedBy")
  createdKnowledgePacks  KnowledgePack[]       @relation("KnowledgePackCreatedBy")
  updatedKnowledgePacks  KnowledgePack[]       @relation("KnowledgePackUpdatedBy")
  createdAiJobs          AiJob[]               @relation("AiJobCreatedBy")
  createdMediaJobs       MediaJob[]            @relation("MediaJobCreatedBy")
  createdVideoRenderJobs VideoRenderJob[]     @relation("VideoRenderJobCreatedBy")
  createdKeywordClusters KeywordCluster[]      @relation("KeywordClusterCreatedBy")
  createdTopicClusters   TopicCluster[]        @relation("TopicClusterCreatedBy")
  createdContentScores   ContentScore[]        @relation("ContentScoreCreatedBy")
  createdSeoReports      SeoReport[]           @relation("SeoReportCreatedBy")
  createdBlogArticles    BlogArticle[]         @relation("BlogArticleCreatedBy")
  updatedBlogArticles    BlogArticle[]         @relation("BlogArticleUpdatedBy")
  createdVideoScripts    VideoScript[]         @relation("VideoScriptCreatedBy")
  updatedVideoScripts    VideoScript[]         @relation("VideoScriptUpdatedBy")
  reviewedInternalLinks  InternalLink[]        @relation("InternalLinkReviewedBy")

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions      RolePermission[]
  workspaceMembers     WorkspaceMember[]
  workspaceInvitations WorkspaceInvitation[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  constant    String   @unique
  category    String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserPasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("user_password_history")
}

// Postgres is the source of truth for sessions — no Redis-only session
// model (standing correction from the Module 1 Engineering Plan).
model UserSession {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])

  // Rotation lineage
  familyId        String        @map("family_id") @db.Uuid
  parentSessionId String?       @map("parent_session_id") @db.Uuid
  parentSession   UserSession?  @relation("SessionRotation", fields: [parentSessionId], references: [id])
  childSessions   UserSession[] @relation("SessionRotation")

  refreshTokenHash String        @unique @map("refresh_token_hash")
  status           SessionStatus @default(ACTIVE)

  issuedAt        DateTime       @default(now()) @map("issued_at")
  expiresAt       DateTime       @map("expires_at")
  familyExpiresAt DateTime       @map("family_expires_at")
  revokedAt       DateTime?      @map("revoked_at")
  revokedReason   RevokedReason? @map("revoked_reason")

  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent")

  // Refinement 2: device metadata — no UI in Module 1B, persisted for
  // future active-session-list / logout-specific-device / trusted-device
  // features.
  deviceName      String?  @map("device_name")
  browser         String?
  operatingSystem String?  @map("operating_system")
  platform        String?
  lastSeenAt      DateTime @default(now()) @map("last_seen_at")

  // Refinement 3: fingerprint — observability/anomaly signal ONLY, never a
  // hard authentication factor. deviceFingerprint is reserved for a future
  // client-supplied value (no frontend exists yet to produce one);
  // sessionFingerprint is computed server-side from available signals.
  deviceFingerprint  String? @map("device_fingerprint")
  sessionFingerprint String? @map("session_fingerprint")

  // Module 1C: convenience-only "last workspace" pointer. Never consulted
  // for authorization — every request still re-validates real membership
  // against the X-Workspace-Id header regardless of this value. See
  // MODULE_1C_ENGINEERING PLAN §2.D.
  lastActiveWorkspaceId String?    @map("last_active_workspace_id") @db.Uuid
  lastActiveWorkspace   Workspace? @relation("LastActiveWorkspace", fields: [lastActiveWorkspaceId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@index([status])
  @@index([expiresAt])
  @@map("user_sessions")
}

// Consolidates password-reset and account-activation tokens — both are
// "one-time, expiring, hashed" tokens differing only in purpose.
model UserActionToken {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id])

  purpose TokenPurpose
  status  TokenActionStatus @default(PENDING)

  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  requestedIp String?   @map("requested_ip")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, purpose, status])
  @@index([expiresAt])
  @@map("user_action_tokens")
}

// Append-only. No deletedAt field exists on this model at all — deletion
// is structurally impossible through the Prisma client, not just forbidden
// by convention.
model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  actorUserId String? @map("actor_user_id") @db.Uuid
  actor       User?   @relation(fields: [actorUserId], references: [id])

  action AuditAction

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  beforeState Json? @map("before_state")
  afterState  Json? @map("after_state")

  ipAddress     String? @map("ip_address")
  requestId     String? @map("request_id")
  correlationId String? @map("correlation_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@index([correlationId])
  @@index([workspaceId])
  @@map("audit_logs")
}

// Module 1C: the tenancy boundary every workspace-scoped table hangs off.
// `slug` is intentionally editable and NOT `@unique` here — permanent,
// history-aware reservation lives in WorkspaceSlugReservation plus a
// deferred composite foreign key added via raw SQL. See
// MODULE_1C_ENGINEERING PLAN §1.
model Workspace {
  id       String          @id @default(uuid()) @db.Uuid
  publicId String          @unique @default(uuid()) @map("public_id") @db.Uuid
  name     String
  slug     String
  status   WorkspaceStatus @default(ACTIVE)

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])

  // Owner/Admin-editable regional/display preferences. Platform-configurable
  // defaults (never hardcoded) applied at creation — see PlatformDefaults
  // config and MODULE_1C_ENGINEERING PLAN §2.F.
  settings Json @default("{}")

  // Platform-controlled, NOT writable through any Module 1C workspace API.
  featureFlags Json @default("{}") @map("feature_flags")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  members                 WorkspaceMember[]
  invitations             WorkspaceInvitation[]
  slugReservations        WorkspaceSlugReservation[]
  projects                Project[]
  projectSlugReservations ProjectSlugReservation[]
  sessionsLastActiveHere  UserSession[]              @relation("LastActiveWorkspace")
  auditLogs               AuditLog[]
  mediaAssets             MediaAsset[]
  contentItems            ContentItem[]
  contentSeries           ContentSeries[]
  contentReviewEvents     ContentReviewEvent[]
  backgroundJobs          BackgroundJob[]
  domainEvents            DomainEvent[]
  scheduledJobs           ScheduledJob[]
  knowledgePacks          KnowledgePack[]
  aiJobs                  AiJob[]
  mediaJobs               MediaJob[]
  videoRenderJobs         VideoRenderJob[]
  keywords                Keyword[]
  keywordClusters         KeywordCluster[]
  topicClusters           TopicCluster[]
  contentScores           ContentScore[]
  seoReports              SeoReport[]
  blogArticles            BlogArticle[]
  videoScripts            VideoScript[]
  internalLinks           InternalLink[]

  @@index([slug])
  @@index([status])
  @@index([createdById])
  @@map("workspaces")
}

// Module 1C: append-only ledger of every slug a workspace has ever held.
// The global UNIQUE(slug) here — not a constraint on workspaces.slug
// itself — is what makes reservation permanent and cross-workspace-
// exclusive. Rows are never deleted or updated by application code in this
// module. See MODULE_1C_ENGINEERING PLAN §1.
model WorkspaceSlugReservation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  slug        String
  createdAt   DateTime  @default(now()) @map("created_at")
  // Never set by any Module 1C code path — reserved for a future,
  // separately-approved release policy.
  releasedAt  DateTime? @map("released_at")

  @@unique([slug])
  @@unique([workspaceId, slug])
  @@map("workspace_slug_reservations")
}

// Module 1C: the real RBAC assignment table — deliberately deferred by
// Module 1B.1. `status` includes PENDING_ACTIVATION for the new-user
// invitation branch: a membership must never be ACTIVE while its user is
// still PENDING_ACTIVATION. See MODULE_1C_ENGINEERING PLAN §2.C.
model WorkspaceMember {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String @map("user_id") @db.Uuid
  user   User   @relation("WorkspaceMemberUser", fields: [userId], references: [id])

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  status WorkspaceMemberStatus @default(PENDING_ACTIVATION)

  invitedById String? @map("invited_by") @db.Uuid
  invitedBy   User?   @relation("WorkspaceMemberInvitedBy", fields: [invitedById], references: [id])

  joinedAt  DateTime? @map("joined_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([status])
  @@map("workspace_members")
}

// Module 1C. `invitedUserId` (nullable) + `invitedEmail` (always present,
// audit/delivery snapshot) implement the corrected identity-binding model:
// when an ACTIVE user exists at invitation-creation time, acceptance is
// keyed to invitedUserId (immune to later email changes); when none exists,
// the invitation stays bound to the email + opaque token. See
// MODULE_1C_ENGINEERING PLAN §2.C″. The partial unique index on
// (workspace_id, invited_email) WHERE status='PENDING' is added via raw SQL
// (not representable in Prisma's schema DSL).
model WorkspaceInvitation {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  invitedEmail  String  @map("invited_email")
  invitedUserId String? @map("invited_user_id") @db.Uuid
  invitedUser   User?   @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id])

  roleId String @map("role_id") @db.Uuid
  role   Role   @relation(fields: [roleId], references: [id])

  tokenHash String                    @unique @map("token_hash")
  status    WorkspaceInvitationStatus @default(PENDING)

  invitedById String @map("invited_by") @db.Uuid
  invitedBy   User   @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  acceptedById String? @map("accepted_by") @db.Uuid
  acceptedBy   User?   @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([invitedEmail])
  @@index([status])
  @@index([expiresAt])
  @@map("workspace_invitations")
}

// Module 1C: foundation only — no project-level membership/role table.
// `slug` is unique within a workspace, permanently reserved once used
// (including after archive/delete), via ProjectSlugReservation + a deferred
// composite foreign key, same pattern as Workspace. See
// MODULE_1C_ENGINEERING PLAN §2.F / §1.
model Project {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name   String
  slug   String
  status ProjectStatus @default(ACTIVE)

  // Module 2 Phase 2.1 (ACR-014): the exact Knowledge Pack version this
  // Project is currently using — a direct FK, no fallback/resolution
  // logic (MODULE_2_KNOWLEDGE_PACK_ARCHITECTURE_V1.0.md §8). Already
  // frozen in AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_V1.0.md §5.2 since
  // Phase-0; never implementable until knowledge_packs existed. Workspace-
  // safe composite FK — a Project can never reference a pack version in a
  // different workspace. No automatic reassignment exists anywhere in
  // this codebase (RESTRICT — enforced at the application layer when a
  // pack version is archived while still referenced here).
  knowledgePackId     String?        @map("knowledge_pack_id") @db.Uuid
  activeKnowledgePack KnowledgePack? @relation("ProjectActiveKnowledgePack", fields: [knowledgePackId, workspaceId], references: [id, workspaceId])

  ownerId String? @map("owner_id") @db.Uuid
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  slugReservations ProjectSlugReservation[]
  mediaAssets      MediaAsset[]
  contentItems     ContentItem[]            @relation("ContentItemProject")
  contentSeries    ContentSeries[]          @relation("ContentSeriesProject")
  knowledgePacks   KnowledgePack[]          @relation("KnowledgePackProject")

  // Module 1E: workspace-safe composite FK target for content_items and
  // content_series' projectId — see MODULE 1E ENGINEERING PLAN
  // "Workspace-Safe Project/Series Relationships". `id` alone is already
  // unique (primary key); this composite adds no new uniqueness
  // guarantee of its own, it only exists to be a valid multi-column FK
  // target so a content item/series can never reference a project in a
  // different workspace.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([slug])
  @@index([status])
  @@index([ownerId])
  @@index([knowledgePackId])
  @@map("projects")
}

// Module 1C: append-only ledger, scoped per workspace — the same slug
// string may be reserved independently in two different workspaces, but
// never twice within one. Rows are never deleted by application code.
model ProjectSlugReservation {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  projectId   String    @map("project_id") @db.Uuid
  project     Project   @relation(fields: [projectId], references: [id])
  slug        String
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, slug])
  @@unique([projectId, slug])
  @@map("project_slug_reservations")
}

// Module 1D: Media Asset Foundation. See MODULE 1D ENGINEERING PLAN —
// FINAL APPROVAL CANDIDATE for the design this implements: claim/finalize
// verification (no DB lock held across storage I/O), declared-vs-verified
// field separation, append-only versioning, per-workspace-only duplicate
// detection, and the retryable-verification state machine (Safeguard 2).
//
// `contentItemId`'s real, workspace-safe composite FK is completed in
// Module 1E, now that `content_items` exists — see MODULE 1E ENGINEERING
// PLAN "Workspace-Safe Media Relationships". Module 1D left it plain and
// unconstrained deliberately, anticipating exactly this.
//
// The two partial unique indexes this design requires (one ACTIVE row per
// assetGroupId; at most one non-terminal replacement per assetGroupId)
// cannot be expressed in Prisma's schema DSL — same limitation already
// worked around in Module 1C (see workspace_invitations_pending_email_unique,
// users_single_platform_owner). They are hand-written in this migration's
// raw SQL alongside Prisma's generated CREATE TABLE statement. The plain
// UNIQUE(asset_group_id, version_number) below (Safeguard 1) IS expressible
// here and needs no hand-written SQL.
model MediaAsset {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation(fields: [projectId], references: [id])

  // Workspace-safe composite FK — see model-level comment above.
  contentItemId String?      @map("content_item_id") @db.Uuid
  contentItem   ContentItem? @relation("MediaAssetContentItem", fields: [contentItemId, workspaceId], references: [id, workspaceId])

  assetType MediaAssetType @map("asset_type")

  originalFilename   String @map("original_filename")
  normalizedFilename String @map("normalized_filename")

  storageProviderIdentity MediaStorageProviderIdentity @map("storage_provider_identity")
  bucket                  String
  objectKey               String                       @unique @map("object_key")

  // Declared: client-supplied at upload-intent time, never trusted alone.
  declaredMimeType  String @map("declared_mime_type")
  declaredSizeBytes BigInt @map("declared_size_bytes")

  // Verified: server/provider-computed at finalize time, authoritative.
  verifiedMimeType  String? @map("verified_mime_type")
  verifiedSizeBytes BigInt? @map("verified_size_bytes")

  extension String

  // Declared vs verified checksum — see plan §6 "Checksum Mechanism".
  expectedChecksumSha256 String? @map("expected_checksum_sha256")
  verifiedChecksumSha256 String? @map("verified_checksum_sha256")

  malwareScanStatus MalwareScanStatus @default(NOT_SCANNED) @map("malware_scan_status")

  // Versioning — see plan §5. First version's own id is its assetGroupId.
  assetGroupId  String @map("asset_group_id") @db.Uuid
  versionNumber Int    @default(1) @map("version_number")

  supersedesAssetId String?      @map("supersedes_asset_id") @db.Uuid
  supersedesAsset   MediaAsset?  @relation("MediaAssetVersionChain", fields: [supersedesAssetId], references: [id])
  supersededBy      MediaAsset[] @relation("MediaAssetVersionChain")

  status     MediaAssetStatus     @default(PENDING_UPLOAD)
  visibility MediaAssetVisibility @default(WORKSPACE_PRIVATE)

  // Machine-readable reason, populated on REJECTED/QUARANTINED/
  // VERIFICATION_FAILED — see plan §4/§9 (Safeguard 2).
  rejectionReason String? @map("rejection_reason")

  // Per-workspace-only duplicate flag — see plan §10 base round. Never a
  // cross-workspace lookup; never physical object dedup.
  duplicateOfAssetId String?      @map("duplicate_of_asset_id") @db.Uuid
  duplicateOfAsset   MediaAsset?  @relation("MediaAssetDuplicate", fields: [duplicateOfAssetId], references: [id])
  duplicatesOfThis   MediaAsset[] @relation("MediaAssetDuplicate")

  // Claim/finalize race guard (plan §4) — also doubles as the
  // retry-verification attempt guard (Safeguard 2): every retry gets a
  // fresh id here, and a finalize that doesn't match the row's current
  // verificationAttemptId is a stale/lost race, not applied.
  verificationAttemptId String?   @map("verification_attempt_id") @db.Uuid
  verificationStartedAt DateTime? @map("verification_started_at")
  verifiedAt            DateTime? @map("verified_at")

  presignedUrlExpiresAt DateTime? @map("presigned_url_expires_at")

  metadata Json @default("{}")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("MediaAssetCreatedBy", fields: [createdById], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  // Module 1E: back-relation for content_items.featuredMediaAssetId's
  // own workspace-safe composite FK into this table.
  featuredInContentItems ContentItem[] @relation("ContentItemFeaturedMedia")

  // Module 2 Phase 2.1: back-relation for brand_guidelines.logoAssetId.
  brandGuidelines BrandGuideline[]

  // Safeguard 1: version numbers can never duplicate within one asset
  // group, expressible directly (unlike the two partial indexes above).
  @@unique([assetGroupId, versionNumber])
  // Module 1E: workspace-safe composite FK target for content_items'
  // contentItemId and featuredMediaAssetId relations.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([assetGroupId])
  @@index([status])
  @@index([workspaceId, verifiedChecksumSha256])
  @@map("media_assets")
}

// Module 1E: Content Foundation. See MODULE 1E ENGINEERING PLAN —
// IMPLEMENTATION-READY FINAL for the full design: the editorial state
// machine (§ Revised State Machine), the current-version composite FK +
// deferred constraint trigger guaranteeing every committed non-deleted
// row has one (hand-written in this migration's raw SQL — no Prisma
// equivalent exists for a deferred trigger), and every workspace-safe
// composite relationship below.
model ContentItem {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK — a content item's project must belong
  // to the SAME workspace; a plain FK on projectId alone couldn't
  // guarantee that.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("ContentItemProject", fields: [projectId, workspaceId], references: [id, workspaceId])

  contentType ContentType @map("content_type")
  title       String

  // Composite ownership FK — the version this points at must belong to
  // THIS item, never another's. Nullable only to allow the
  // create-item-then-create-version-then-link sequence; the deferred
  // trigger (migration raw SQL) guarantees it is never left null past
  // commit for a non-deleted row.
  currentVersionId String?         @map("current_version_id") @db.Uuid
  currentVersion   ContentVersion? @relation("ContentItemCurrentVersion", fields: [currentVersionId, id], references: [id, contentItemId])

  // Workspace-safe composite FK.
  seriesId String?        @map("series_id") @db.Uuid
  series   ContentSeries? @relation(fields: [seriesId, workspaceId], references: [id, workspaceId])

  // Workspace-safe composite FK. Valid only if null, or points at an
  // asset already linked to this same item, or an unassigned
  // workspace-level asset — never an asset linked to a different item
  // (service-level rule, not expressible as a single FK condition).
  featuredMediaAssetId String?     @map("featured_media_asset_id") @db.Uuid
  featuredMediaAsset   MediaAsset? @relation("ContentItemFeaturedMedia", fields: [featuredMediaAssetId, workspaceId], references: [id, workspaceId])

  status             ContentItemStatus  @default(DRAFT)
  // Set at archive time, consulted (via an explicit allow-list, never
  // inferred) at restore time — see plan's Archive/Restore Rules.
  archivedFromStatus ContentItemStatus? @map("archived_from_status")

  // Generic, type-agnostic bag — Module 1E deliberately defers real
  // blog_articles/video_scripts extension tables, same precedent as
  // Module 1D deferring media's own type-specific extension tables.
  metadata Json @default("{}")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ContentItemCreatedBy", fields: [createdById], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  versions      ContentVersion[]     @relation("ContentItemVersions")
  reviewEvents  ContentReviewEvent[]
  mediaAssets   MediaAsset[]         @relation("MediaAssetContentItem")
  mediaJobs     MediaJob[]           @relation("MediaJobContentItem")
  videoRenderJobs VideoRenderJob[]   @relation("VideoRenderJobContentItem")
  contentScores ContentScore[]
  seoReports    SeoReport[]
  blogArticle   BlogArticle?
  videoScript   VideoScript?
  // Module 8 Phase 8.1: an item can appear as either side of an
  // InternalLink — two distinct named relations, same pattern as
  // BlogArticle.createdBy/updatedBy both pointing at User.
  internalLinksAsSource InternalLink[] @relation("InternalLinkSource")
  internalLinksAsTarget InternalLink[] @relation("InternalLinkTarget")

  // Workspace-safe composite FK target for content_review_events'
  // contentItemId relation.
  @@unique([id, workspaceId])
  // `id` alone already guarantees (currentVersionId, id) is unique —
  // Prisma requires it declared explicitly to recognize the to-one
  // relation shape on this side.
  @@unique([currentVersionId, id])
  @@index([workspaceId])
  @@index([projectId])
  @@index([seriesId])
  @@index([status])
  @@index([contentType])
  @@map("content_items")
}

// Immutable — an edit always inserts a new row, never mutated or
// deleted. UNIQUE(contentItemId, versionNumber) is Safeguard-equivalent
// to Module 1D's version-number invariant, same pattern reused directly.
// UNIQUE(id, contentItemId) is what makes the current-version and
// review-event ownership composite FKs possible — one constraint, two
// consumers.
model ContentVersion {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  contentItemId String      @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation("ContentItemVersions", fields: [contentItemId], references: [id])

  versionNumber Int @map("version_number")

  // Opaque JSONB — validated (size/depth/type/minimal per-type shape,
  // three-tier binary-content heuristic) at the service layer before
  // storage; never interpreted further by Module 1E once accepted. See
  // plan's Body Validation Contract.
  body Json

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ContentVersionCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  currentForItem ContentItem?         @relation("ContentItemCurrentVersion")
  reviewEvents   ContentReviewEvent[]

  @@unique([contentItemId, versionNumber])
  @@unique([id, contentItemId])
  @@index([contentItemId])
  @@map("content_versions")
}

// Minimal, intentionally — a label/grouping with no workflow of its own,
// hence a plain nullable deletedAt rather than a full status enum. See
// plan's "Content Series Must Be Usable or Deferred" — included, not
// deferred, with workspace-scoped CRUD and RESTRICT-style delete
// protection while active content items still reference it.
model ContentSeries {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("ContentSeriesProject", fields: [projectId, workspaceId], references: [id, workspaceId])

  name String

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ContentSeriesCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  contentItems  ContentItem[]
  topicClusters TopicCluster[]

  // Workspace-safe composite FK target for content_items.seriesId and
  // topic_clusters.contentSeriesId.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@map("content_series")
}

// Append-only business record of every submit/approve/reject action —
// never audit_logs alone, since a required rejection comment is a
// business fact, not incidental diagnostic metadata. Both composite FKs
// are workspace/ownership-safety guarantees: this event's workspaceId
// genuinely matches its content item's actual workspace, and its
// reviewed version genuinely belongs to that exact content item (reusing
// content_versions' own id+contentItemId uniqueness).
model ContentReviewEvent {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contentItemId String      @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation(fields: [contentItemId, workspaceId], references: [id, workspaceId])

  contentVersionId String         @map("content_version_id") @db.Uuid
  contentVersion   ContentVersion @relation(fields: [contentVersionId, contentItemId], references: [id, contentItemId])

  action  ContentReviewAction
  // Required + non-empty (trimmed) for REJECTED, optional (but bounded)
  // otherwise — enforced at DTO, service, AND database layers (a raw SQL
  // CHECK constraint, hand-written in this migration).
  comment String?

  actorId String @map("actor_id") @db.Uuid
  actor   User   @relation(fields: [actorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contentItemId])
  @@index([workspaceId])
  @@map("content_review_events")
}

// Module 1F: System Services Foundation. Reserved strictly for non-AI,
// non-publishing SYSTEM MAINTENANCE work (DB Design §5.12, ADR-005) —
// never a generic tracking table for future ai_jobs/publishing_jobs,
// which bring their own dedicated tables when their owning modules ship.
// `status` draws only from BackgroundJobStatus's frozen 5 values — see
// that enum's comment for exactly how CANCELLED/SCHEDULED/RETRYING/
// DEAD_LETTERED are represented without extending it:
//   - SCHEDULED (not yet due)  -> status=QUEUED from creation,
//     scheduledAt in the future; BullMQ's native delay handles
//     dispatch-eligibility.
//   - RETRYING                -> status stays QUEUED/RUNNING
//     (Queue Engine §4's own internal->external mapping); recorded as a
//     job_history transition, attempts incremented.
//   - CANCEL_REQUESTED        -> status unchanged, cancellationRequestedAt
//     set; workers check this cooperatively.
//   - CANCELLED               -> terminal status=FAILED,
//     errorCode='JOB_CANCELLED_BY_USER', cancelledAt set — the exact
//     pattern Queue Engine §4 already established for Publishing's
//     PUBLISH_CANCELLED_BY_USER.
//   - DEAD_LETTERED           -> terminal status=FAILED, deadLetteredAt
//     set — a marker, not a new status.
model BackgroundJob {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  // Nullable — mirrors AuditLog.workspaceId exactly, not a blanket
  // exception to "every business entity requires workspace_id" (this
  // table sits in DB Design §5.12's platform-level System group).
  // NOT NULL whenever a job is workspace-triggered; null only for
  // genuine platform-level system jobs.
  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  // Full versioned registry key, e.g. "system.ping.v1" — see
  // ProcessorManifest (Module 1F Engineering Plan §4). Not an FK; the
  // registry is a compile-time/bootstrap-time construct, not a DB table.
  jobType   String    @map("job_type")
  queueName QueueName @map("queue_name")

  // Dispatch-layer pointer only — never authoritative (ADR-007: Postgres
  // is the source of truth, this row is, Redis/BullMQ state is
  // rebuildable from it).
  bullmqJobId String? @map("bullmq_job_id")

  status BackgroundJobStatus @default(QUEUED)

  payloadMetadata Json  @default("{}") @map("payload_metadata")
  resultMetadata  Json? @map("result_metadata")
  progress        Int?

  attempts    Int @default(0)
  maxAttempts Int @default(3) @map("max_attempts")

  // Scoped per-workspace via the composite unique below — see Module 1F
  // Engineering Plan §7. NULL means no dedup was requested for this job.
  idempotencyKey String? @map("idempotency_key")

  scheduledAt DateTime? @map("scheduled_at")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  failedAt    DateTime? @map("failed_at")

  // Set the moment a cancellation is requested, independent of whether
  // the job has actually stopped yet — workers/schedulers check this
  // cooperatively (Engineering Plan §9). Never a status value.
  cancellationRequestedAt DateTime? @map("cancellation_requested_at")
  cancelledAt             DateTime? @map("cancelled_at")
  deadLetteredAt          DateTime? @map("dead_lettered_at")

  errorCode        String? @map("error_code")
  // Always curated text — never a raw stack trace. The raw error goes
  // only to structured logs, keyed by correlationId.
  errorMessageSafe String? @map("error_message_safe")

  // Seeded from the triggering request's X-Request-ID at enqueue time
  // (or generated for system-triggered jobs); propagated through every
  // job_history row and structured log line for this job. Architectural
  // metadata only — does not participate in status/transition logic.
  correlationId String @map("correlation_id")

  // Enables future workflow chaining / parent-child execution graphs.
  // Plain self-FK, deliberately NOT the workspace-safe composite pattern
  // used elsewhere (e.g. content_items -> project): workspaceId is
  // nullable here, which would silently exempt platform-level jobs from
  // that composite check anyway (MATCH SIMPLE semantics), and Module 1F
  // implements no cascading-cancellation or dependency-gating logic on
  // this column at all — purely reserved metadata for future
  // orchestration. A future module that builds real orchestration logic
  // can add a stricter constraint then, driven by a real design.
  parentJobId String?         @map("parent_job_id") @db.Uuid
  parentJob   BackgroundJob?  @relation("BackgroundJobParent", fields: [parentJobId], references: [id])
  childJobs   BackgroundJob[] @relation("BackgroundJobParent")

  // Identifies exactly which deployed processor implementation executed
  // this job — distinct from jobType's own .v{n} contract-version suffix.
  // Written when execution begins (RUNNING transition), never at enqueue
  // time. Sourced from the same applicationVersion WorkerHeartbeat
  // already reports — not a second, independently-maintained version
  // string. Purely additive metadata: no lifecycle, retry, or versioning
  // rule depends on it.
  processorVersion String? @map("processor_version")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("BackgroundJobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  history BackgroundJobHistory[]
  // Module 3 Phase 3.3 — present only when this row is dispatching an
  // "ai.execute.v1" job; see AiJob.backgroundJobId's own comment.
  aiJob   AiJob?
  // Module 7 Phase 7.4 — present only when this row is dispatching a
  // media.* job; see MediaJob.backgroundJobId's own comment.
  mediaJob MediaJob?
  // Module 7 Phase 7.5 — present only when this row is dispatching a
  // media.video-render.v1 job; see VideoRenderJob.backgroundJobId.
  videoRenderJob VideoRenderJob?

  // DEFECT-1F-003: idempotency uniqueness is enforced by two migration-only
  // PARTIAL unique indexes, not representable in Prisma's schema DSL (no
  // previewFeatures enable filtered/partial index support here) — see
  // migrations/20260806180000_defect_1f003_platform_idempotency:
  //   background_jobs_workspace_idempotency_unique
  //     ON (workspace_id, idempotency_key) WHERE workspace_id IS NOT NULL
  //     AND idempotency_key IS NOT NULL
  //   background_jobs_platform_idempotency_unique
  //     ON (idempotency_key) WHERE workspace_id IS NULL
  //     AND idempotency_key IS NOT NULL
  // A single non-partial @@unique([workspaceId, idempotencyKey]) (the
  // original Milestone 1/6 design) does NOT deduplicate platform-level
  // rows (workspace_id IS NULL) under standard SQL NULL semantics — that
  // was DEFECT-1F-003. Do not reintroduce it; `prisma migrate dev`/`db
  // push` must never be run against this model without `--create-only`
  // or they will attempt to "correct" this intentional schema/DB drift.
  @@index([workspaceId])
  @@index([status])
  @@index([jobType])
  @@index([queueName])
  @@index([parentJobId])
  @@index([correlationId])
  @@map("background_jobs")
}

// Append-only, mirrors publishing_history's established pattern exactly.
// Carries the finer engine-internal states (RESERVED/RETRYING/
// WAITING_DEPENDENCY/EXPIRED/ARCHIVED, Queue Engine §4) that never become
// BackgroundJob.status values themselves.
model BackgroundJobHistory {
  id String @id @default(uuid()) @db.Uuid

  backgroundJobId String        @map("background_job_id") @db.Uuid
  backgroundJob   BackgroundJob @relation(fields: [backgroundJobId], references: [id])

  // Nullable — the very first transition (job creation) has no "from".
  fromStatus BackgroundJobStatus? @map("from_status")
  toStatus   BackgroundJobStatus  @map("to_status")

  occurredAt DateTime @default(now()) @map("occurred_at")
  // Safe-redacted only — same discipline as BackgroundJob.errorMessageSafe.
  detail     Json?

  @@index([backgroundJobId])
  @@map("job_history")
}

// Operational infrastructure, not a business entity — no workspace_id,
// no soft delete, short retention. Complements (does not replace) BullMQ's
// own native job-level stalled-job detection: BullMQ already requeues a
// job whose worker died mid-processing via its own lock+lockRenewTime
// mechanism (Queue Engine §11's "Worker Crash -> requeue via heartbeat
// timeout" refers to that library-native behavior). This table is a
// separate, process-level visibility layer — dashboards, worker-crash
// alerting, version-rollout tracking, capacity planning — never a job
// action trigger.
model WorkerHeartbeat {
  workerId String @id @map("worker_id") @db.Uuid

  hostname           String
  processId          Int    @map("process_id")
  applicationVersion String @map("application_version")
  queueAssignments   Json   @map("queue_assignments")

  startedAt       DateTime @map("started_at")
  lastHeartbeatAt DateTime @map("last_heartbeat_at")

  @@index([lastHeartbeatAt])
  @@map("worker_heartbeats")
}

// Module 1F Milestone 7 (Scheduler Foundation), Revision 3 §3. Reserved
// for future strategies — exactly one implemented today, mirroring the
// same "declare the concept, ship one value" pattern already used for
// ProcessorManifest.schemaVersion and the frozen missed-run policy.
enum ScheduleIdempotencyStrategy {
  SCHEDULE_TICK_TIMESTAMP
}

// Module 1F Milestone 7 (Scheduler Foundation), Revision 3 §2/§3. A
// persistent, optimistically-versioned recurring/one-off schedule
// definition — the source of truth SchedulerTickManager's own scan
// (apps/worker) reads from; BullMQ/Redis holds no business state for
// this table at all (Revision 3 §5). Every dispatched occurrence still
// becomes an ordinary `background_jobs` row via the identical
// row-then-BullMQ pattern every other job in this system already uses —
// this table's own rows are never themselves executed directly.
model ScheduledJob {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  // Nullable — mirrors BackgroundJob.workspaceId exactly: NOT NULL for a
  // workspace-owned schedule, NULL only for a genuine platform-level one.
  // Managed exclusively through the two structurally separate route
  // surfaces (Revision 3 §3/§4) — never accepted from a request body.
  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  // Registry key this schedule dispatches — validated against the live
  // ProcessorManifest registry at write time, not an FK (same reasoning
  // as BackgroundJob.jobType: the registry is a bootstrap-time construct).
  jobType         String @map("job_type")
  payloadMetadata Json   @default("{}") @map("payload_metadata")

  // The authoritative schedule definition (Revision 3 §5) — nextRunAt
  // below is a cache derived from these two fields, never the reverse.
  // Both validated (cron-parser / IANA) at Create and Update time, using
  // the identical evaluation path SchedulerTickManager itself uses.
  cronExpression String @map("cron_expression")
  timezone       String @default("UTC")

  enabled Boolean @default(true)

  // Cache only, for efficient due-schedule scanning — self-healing per
  // Revision 3 §5: always recomputed fresh from (cronExpression,
  // timezone, now()) at create, at update, and at every claim; never
  // trusted as authoritative, never incremented from its own stale value.
  nextRunAt DateTime? @map("next_run_at")
  // Set on every claim, regardless of outcome — "this occurrence was
  // dispatched," not "this occurrence succeeded."
  lastRunAt DateTime? @map("last_run_at")

  // Present, intentionally unpopulated in Milestone 7 (Revision 3 §6) —
  // deferred to the future milestone that integrates the Event Bus /
  // execution-lifecycle signals these two fields actually need.
  lastSuccessAt DateTime? @map("last_success_at")
  lastFailureAt DateTime? @map("last_failure_at")

  // Populated only by the permanent-failure auto-disable path (Revision 3
  // §7) — curated text only, mirrors BackgroundJob.errorCode/
  // errorMessageSafe's own established shape. Cleared by a successful
  // Update, never by Enable alone.
  lastErrorCode        String? @map("last_error_code")
  lastErrorMessageSafe String? @map("last_error_message_safe")

  idempotencyStrategy ScheduleIdempotencyStrategy @default(SCHEDULE_TICK_TIMESTAMP) @map("idempotency_strategy")

  // Optimistic-concurrency counter (Revision 3 §4) — incremented on every
  // mutation to this row, human-initiated (the API's Update) or
  // system-initiated (a scan's own claim, or the auto-disable path).
  version Int @default(1)

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("ScheduledJobCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by") @db.Uuid
  updatedBy   User?   @relation("ScheduledJobUpdatedBy", fields: [updatedById], references: [id])

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([enabled])
  @@index([jobType])
  @@map("scheduled_jobs")
}

// Transactional outbox (Module 1F Engineering Plan §11) — the mechanism
// that avoids dual-write inconsistency between a Postgres business write
// and a Redis/BullMQ enqueue. Every state change that must emit an event
// writes a row here in the SAME transaction as its business write; a
// separate outbox-relay process polls undispatched rows (SELECT ... FOR
// UPDATE SKIP LOCKED, competing-consumers-safe) and enqueues them,
// marking dispatchedAt afterward. A crash between the enqueue and that
// mark means at-least-once delivery — every consumer must be idempotent
// (see ProcessedEvent) and order-tolerant (BullMQ does not guarantee
// strict cross-worker delivery ordering).
model DomainEvent {
  id String @id @default(uuid()) @db.Uuid

  eventType    String @map("event_type")
  eventVersion Int    @map("event_version")

  workspaceId String?    @map("workspace_id") @db.Uuid
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  correlationId String? @map("correlation_id")
  causationId   String? @map("causation_id")

  payload Json

  occurredAt   DateTime  @default(now()) @map("occurred_at")
  // NULL = not yet relayed to BullMQ. See the hand-written partial index
  // in this migration's raw SQL for the relay's actual poll query.
  dispatchedAt DateTime? @map("dispatched_at")

  // Milestone 8.2 correctness fix (claim/lease model) — added because
  // FOR UPDATE SKIP LOCKED alone only provides mutual exclusion for the
  // lifetime of the claiming transaction, which the "no Redis/BullMQ
  // call under a held row lock" invariant forces to commit BEFORE
  // dispatch even starts. Without a persisted lease, a second relay tick
  // (this instance's next tick, or a different replica) can re-claim and
  // re-dispatch the same still-undispatched row while the first attempt
  // is mid-flight — empirically confirmed against real Postgres. All
  // three are set together by the atomic claim UPDATE, extended by
  // lease-renewal UPDATEs guarded on claimToken while dispatch is in
  // progress, and cleared together by a successful, ownership-guarded
  // finalize. A row with claimExpiresAt in the past is exactly as
  // eligible for claim as one that was never claimed at all — that is
  // the entire crash-recovery mechanism, no separate sweep/cleanup job
  // is needed.
  claimToken     String?   @map("claim_token") @db.Uuid
  claimedAt      DateTime? @map("claimed_at")
  claimExpiresAt DateTime? @map("claim_expires_at")

  consumers ProcessedEvent[]

  @@index([workspaceId])
  @@index([correlationId])
  @@map("domain_events")
}

// Consumer-side idempotency for at-least-once event delivery (Engineering
// Plan §11) — the same mechanism family as BackgroundJob's idempotencyKey.
model ProcessedEvent {
  id String @id @default(uuid()) @db.Uuid

  eventId String      @map("event_id") @db.Uuid
  event   DomainEvent @relation(fields: [eventId], references: [id])

  consumerName String   @map("consumer_name")
  processedAt  DateTime @default(now()) @map("processed_at")

  @@unique([eventId, consumerName])
  @@map("processed_events")
}

// Module 2 Phase 2.1: Knowledge Pack Engine — database/domain foundation.
// See MODULE_2_KNOWLEDGE_PACK_ARCHITECTURE_V1.0.md and ACR-014
// (ARCHITECTURE_DECISION_RECORDS_V1.0.md ADR-014) for the full design —
// not redesigned here, only implemented.

enum KnowledgePackStatus {
  DRAFT
  VALIDATING
  ACTIVE
  ARCHIVED
}

enum KnowledgeSourceType {
  GOVERNMENT
  ASSOCIATION
  COMPANY
  PUBLICATION
  RSS
}

// Aggregate root (one row per version). lineageRootId and
// currentVersionOfId are deliberately distinct, never-conflated concepts
// (ADR-014): lineageRootId is the permanent identity of one logical
// Knowledge Pack across every version it will ever have (equal to the
// root version's own id, copied forward unchanged on every successor,
// never recomputed); currentVersionOfId is only the immediate-predecessor
// pointer (linked-list). The partial unique index enforcing "at most one
// non-deleted ACTIVE row per lineageRootId" is not expressible in
// Prisma's schema DSL — same limitation already worked around for
// media_assets_one_active_version_per_group — hand-written in this
// migration's raw SQL.
model KnowledgePack {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  // Phase 2.2: a human-identifying label, needed for list/create/get to be
  // usable at all — every other named entity in this schema
  // (workspaces/projects/brands/keyword_sets) already has one; Database
  // Design's own §5.3 field summary omitted it (an abbreviated listing,
  // not an exhaustive one — matches how "brand name required" in FR-KP-001's
  // Validation Rules is otherwise unrepresentable as any concrete column).
  // Not an architectural decision — no ACR precedent exists anywhere in
  // this repo for adding a plain, universally-precedented name field.
  name String

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK — a pack may be workspace-wide (null) or
  // scoped to one project, but can never reference a project in a
  // different workspace.
  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("KnowledgePackProject", fields: [projectId, workspaceId], references: [id, workspaceId])

  industryProfile    Json @default("{}") @map("industry_profile")
  publishingStrategy Json @default("{}") @map("publishing_strategy")

  versionNumber Int @default(1) @map("version_number")

  // Immediate-predecessor pointer only (ADR-014) — workspace-safe
  // composite self-FK, so a lineage can never cross a workspace boundary.
  // Phase 2.4: at most one non-deleted successor per predecessor, via the
  // hand-written partial unique index `knowledge_packs_one_successor_per_predecessor`
  // — protects concurrent version creation against duplicate/divergent
  // successors (not expressible in this schema DSL).
  currentVersionOfId String?         @map("current_version_of") @db.Uuid
  currentVersionOf   KnowledgePack?  @relation("KnowledgePackVersionChain", fields: [currentVersionOfId, workspaceId], references: [id, workspaceId])
  supersededBy       KnowledgePack[] @relation("KnowledgePackVersionChain")

  // Permanent lineage identity (ADR-014) — see model comment above.
  // Enforces "at most one non-deleted ACTIVE row per lineage" via the
  // hand-written partial unique index in this migration.
  lineageRootId String @map("lineage_root_id") @db.Uuid

  // Aggregate-root-only optimistic concurrency (ADR-014) — protects the
  // whole aggregate, including child-table mutations performed through
  // aggregate-level operations. No child table carries its own
  // lock_version.
  lockVersion Int @default(1) @map("lock_version")

  status KnowledgePackStatus @default(DRAFT)

  createdById String  @map("created_by") @db.Uuid
  createdBy   User    @relation("KnowledgePackCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by") @db.Uuid
  updatedBy   User?   @relation("KnowledgePackUpdatedBy", fields: [updatedById], references: [id])

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")
  deletedAt  DateTime? @map("deleted_at")

  knowledgeSources KnowledgeSource[]
  promptTemplates  PromptTemplate[]
  seoRules         KnowledgePackSeoRule[]
  brandGuidelines  BrandGuideline[]
  keywordSets      KeywordSet[]
  competitors      Competitor[]

  // Projects currently using this exact version as their active pack —
  // see MODULE_2_KNOWLEDGE_PACK_ARCHITECTURE_V1.0.md §8: no automatic
  // reassignment exists; a version cannot be archived while any Project
  // still references it (RESTRICT).
  activeForProjects Project[] @relation("ProjectActiveKnowledgePack")

  // Module 3 Phase 3.2: every AI Job records the EXACT Knowledge Pack
  // version it executed against (never the lineage root) — see AiJob
  // below and AI_AGENT_FRAMEWORK_V1.0.md's Knowledge-Pack-driven design
  // principle / ADR-004.
  aiJobs AiJob[]

  // Module 5 Phase 5.1: the exact Knowledge Pack version a materialized
  // KeywordCluster's own Research run executed against.
  keywordClusters KeywordCluster[]

  // Workspace-safe composite FK target for projectId/currentVersionOfId
  // above and for projects.knowledge_pack_id.
  @@unique([id, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([lineageRootId])
  @@index([status])
  @@map("knowledge_packs")
}

model KnowledgeSource {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  sourceType KnowledgeSourceType @map("source_type")
  url        String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@map("knowledge_sources")
}

model PromptTemplate {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  contentType ContentType @map("content_type")
  promptBody  String      @map("prompt_body")

  // Template-level revision counter — independent of
  // knowledge_packs.version_number (ADR-014, two intentionally
  // coexisting versioning layers). Free to advance while the parent
  // pack is still DRAFT; frozen the instant the parent becomes ACTIVE.
  versionNumber Int @default(1) @map("version_number")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@index([knowledgePackId, contentType])
  @@map("prompt_templates")
}

model KnowledgePackSeoRule {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  primaryKeywords       Json @default("[]") @map("primary_keywords")
  secondaryKeywords     Json @default("[]") @map("secondary_keywords")
  internalLinkingPolicy Json @default("{}") @map("internal_linking_policy")
  schemaPreferences     Json @default("{}") @map("schema_preferences")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@map("seo_rules")
}

model BrandGuideline {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  toneOfVoice String? @map("tone_of_voice")
  terminology Json    @default("{}")
  ctaRules    String? @map("cta_rules")

  logoAssetId String?     @map("logo_asset_id") @db.Uuid
  logoAsset   MediaAsset? @relation(fields: [logoAssetId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@map("brand_guidelines")
}

model KeywordSet {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  name     String
  keywords Json   @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@map("keyword_sets")
}

model Competitor {
  id String @id @default(uuid()) @db.Uuid

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId], references: [id])

  domain String
  notes  String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([knowledgePackId])
  @@map("competitors")
}

// Module 3 Phase 3.2 — AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_V1.0.md
// §24.8 (exact enum), §5.5 ("ai_jobs" field list). ADR-005 resolved the
// earlier three-way ambiguity between ai_jobs/background_jobs/BullMQ
// itself: `ai_jobs` is the sole authoritative business record for AI
// work — DB Design §5.12 explicitly reserves `background_jobs`/
// `job_history` for non-AI, non-publishing system maintenance only, so
// this table is never a `background_jobs` row and vice versa.
enum AiJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

// Phase 3.2 executes this synchronously end-to-end (see AgentExecutorService)
// — durable async dispatch through Module 1F's Queue Engine is real,
// scoped future work (see PR description), not silently pulled forward
// here. Every execution, sync or future-async, persists through this
// same table regardless of dispatch mechanism.
model AiJob {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Registry-resolved identifier/version — not an FK. Mirrors
  // ProcessorManifest's own "the registry is a compile-time/bootstrap-time
  // construct, not a DB table" convention (see AgentRegistry in
  // @myev/shared). agentVersion is a DB Design §5.5 field-list addition
  // (same class of justified, documented addition as
  // KnowledgePack.name in Phase 2.2) — required for execution-provenance
  // reproducibility (Part 4/9 of Phase 3.2's own spec).
  agentName    String @map("agent_name")
  agentVersion Int    @map("agent_version")

  triggeringModule String @map("triggering_module")

  // Module 3 Phase 3.3 — the durable dispatch/runtime record driving this
  // AiJob's execution. Nullable: a synchronously-executed AiJob (Phase
  // 3.2's own AgentExecutorService.execute(), still valid and unchanged)
  // never has one; only a durably-submitted AiJob (Phase 3.3's own
  // submission flow) does. Deliberately the ONLY linkage field —
  // BackgroundJob itself carries no AI-specific columns at all (its own
  // payloadMetadata JSON holds this AiJob's publicId, the minimum it
  // needs to dispatch); DB Design §5.12 reserves background_jobs for
  // non-AI/non-publishing infrastructure, and ADR-005 makes ai_jobs its
  // own authoritative store — this FK is metadata connecting the two
  // records, not a merge of their lifecycles. Also the fencing token for
  // execution idempotency: the worker processor only advances this row
  // past QUEUED when it currently equals the BackgroundJob id driving the
  // attempt, so a stale/duplicate redelivery can't double-execute it.
  // @unique — one BackgroundJob drives exactly one AiJob (its payload's
  // aiJobPublicId is fixed at enqueue time), so this is a true 1:1, not a
  // many-to-one.
  backgroundJobId String?        @unique @map("background_job_id") @db.Uuid
  backgroundJob   BackgroundJob? @relation(fields: [backgroundJobId], references: [id])

  // The EXACT Knowledge Pack version row this job executed against —
  // never the lineage root, never implicitly re-resolved to "latest
  // active" after the fact (ADR-004 + Module 2's own non-substitution
  // principle, reused verbatim here for execution provenance).
  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId, workspaceId], references: [id, workspaceId])

  inputPayload  Json  @map("input_payload")
  outputPayload Json? @map("output_payload")

  providerUsed       String?  @map("provider_used")
  modelUsed          String?  @map("model_used")
  tokenUsage         Json?    @map("token_usage")
  // Precision matches typical per-token vendor pricing (fractional cents
  // per 1K tokens) — no cost/pricing table exists yet (Part 13 of Phase
  // 3.2's own spec: persist usage metadata without inventing fake
  // pricing logic), so this stays nullable until a real pricing source
  // is designed.
  costEstimate       Decimal? @map("cost_estimate") @db.Decimal(10, 6)
  // Module 3 Phase 3.5 — the exact temperature/maxTokens/timeoutMs
  // resolveAgentExecution() resolved for this execution (agent-declared
  // generationDefaults merged with any caller override), completing
  // execution provenance: null only for a job that never reached a
  // resolved provider (e.g. UNKNOWN_AGENT, KNOWLEDGE_PACK_NOT_ACTIVE).
  generationSettings Json?    @map("generation_settings")

  status AiJobStatus @default(QUEUED)

  // Same safe-error discipline as BackgroundJob.errorMessageSafe — curated
  // text only, never a raw stack trace or AIProviderError's own raw SDK
  // detail.
  errorCode        String? @map("error_code")
  errorMessageSafe String? @map("error_message_safe")

  // Seeded from the triggering request's correlation id — propagated
  // through every ai_job_steps row, mirrors BackgroundJob.correlationId.
  correlationId String @map("correlation_id")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  // Nullable — mirrors BackgroundJob.createdById exactly: NOT NULL
  // whenever a human/API caller triggered this job, null only for a
  // genuine system-triggered execution.
  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("AiJobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  steps AiJobStep[]

  // Module 5 Phase 5.1: a completed Research run's own keywordClusters[]
  // JSONB output, materialized on demand into real rows once a user
  // actually promotes one via topic_clusters.
  keywordClusters KeywordCluster[]

  @@index([workspaceId])
  @@index([status])
  @@index([status, createdAt])
  @@index([knowledgePackId])
  @@index([correlationId])
  @@map("ai_jobs")
}

// Append-only step log — mirrors BackgroundJobHistory's own shape/
// discipline (no deletedAt, never updated after insert).
model AiJobStep {
  id String @id @default(uuid()) @db.Uuid

  aiJobId String @map("ai_job_id") @db.Uuid
  aiJob   AiJob  @relation(fields: [aiJobId], references: [id])

  stepName   String      @map("step_name")
  stepStatus AiJobStatus @map("step_status")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  @@index([aiJobId])
  @@map("ai_job_steps")
}

// Module 7 Phase 7.4 — Media Generation domain record. The image/voice/
// subtitle analogue of ai_jobs: the authoritative business record for one
// media-generation unit of work, linked 1:1 to a generic background_jobs
// row (background_job_id) that drives its dispatch on QueueName.MEDIA.
// The BullMQ payload only ever carries this row's public_id — never the
// prompt, provider output bytes, or credentials.
//
// operation discriminates the three families; provider/model/usage/cost
// mirror the ai_jobs field list exactly. output_payload holds only small
// operational pointers (the produced MediaAsset public_ids, the
// word-timing sidecar object key) — never binary media.
model MediaJob {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK (same pattern as MediaAsset/ContentScore).
  contentItemId String?      @map("content_item_id") @db.Uuid
  contentItem   ContentItem? @relation("MediaJobContentItem", fields: [contentItemId, workspaceId], references: [id, workspaceId])

  operation MediaJobOperation @map("operation")

  // The dispatch/runtime record. Nullable only for the brief window
  // between media_jobs create and background_jobs enqueue+link (mirrors
  // AiJob.backgroundJobId). @unique — one BackgroundJob drives exactly
  // one MediaJob. Also the fencing token: the worker processor only
  // advances this row past QUEUED when it equals the BackgroundJob id
  // driving the attempt.
  backgroundJobId String?        @unique @map("background_job_id") @db.Uuid
  backgroundJob   BackgroundJob? @relation(fields: [backgroundJobId], references: [id])

  inputPayload  Json  @map("input_payload")
  outputPayload Json? @map("output_payload")

  providerUsed String? @map("provider_used")
  modelUsed    String? @map("model_used")
  // Provider-neutral units, e.g. { imageCount, size } or
  // { characterCount, audioSeconds }. Nullable — mirrors
  // AiJob.tokenUsage.
  usageMetadata Json? @map("usage_metadata")
  // Same precision/nullability discipline as AiJob.costEstimate: no fake
  // pricing — null until a real per-unit price is configured.
  costEstimate Decimal? @map("cost_estimate") @db.Decimal(10, 6)

  status MediaJobStatus @default(QUEUED)

  // Curated text only — never a raw SDK error, stack trace, or anything
  // that could carry a credential (same discipline as
  // AiJob.errorMessageSafe).
  errorCode        String? @map("error_code")
  errorMessageSafe String? @map("error_message_safe")

  correlationId String @map("correlation_id")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("MediaJobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@index([status])
  @@index([correlationId])
  @@index([contentItemId])
  @@map("media_jobs")
}

// Module 7 Phase 7.5 — identical vocabulary to MediaJobStatus / AiJobStatus
// / the frozen FRD §24 Job Status enum. Reused, not re-invented — a render
// job has no "fake business completion" state (checkpoint §2): Gate #4 is
// satisfied by reconciliation against a persisted ACTIVE VIDEO MediaAsset,
// never by COMPLETED alone.
enum VideoRenderJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  TIMED_OUT
}

// Module 7 Phase 7.5 — Video Rendering (VIDEO_AUTOMATION_ENGINE_V1.0.md §7,
// FR-VID-007, checkpoint D5). The render analogue of MediaJob: a business
// extension row (the render lifecycle, the frozen VideoRenderInputV1
// snapshot, the produced-artifact metadata) linked 1:1 to a generic
// background_jobs dispatch row. Purely additive. The rendered binary is
// NEVER stored here — it lands in object storage as a VIDEO MediaAsset;
// this row only records its identity + inspected metadata.
//
// History is retained: a regenerated upstream artifact does not delete or
// mutate a prior render job or its output asset (checkpoint §24) — a new
// submission creates a new row with a new input snapshot, and only that
// newest COMPLETED row whose snapshot still matches current dependencies
// satisfies Gate #4.
model VideoRenderJob {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK (same pattern as MediaJob / MediaAsset).
  contentItemId String      @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation("VideoRenderJobContentItem", fields: [contentItemId, workspaceId], references: [id, workspaceId])

  // The dispatch/runtime record. Nullable only between video_render_jobs
  // create and background_jobs enqueue+link (mirrors MediaJob). @unique —
  // one BackgroundJob drives exactly one VideoRenderJob. Also the fencing
  // token: the render worker only advances this row past QUEUED when it
  // equals the BackgroundJob id driving the attempt.
  backgroundJobId String?        @unique @map("background_job_id") @db.Uuid
  backgroundJob   BackgroundJob? @relation(fields: [backgroundJobId], references: [id])

  status VideoRenderJobStatus @default(QUEUED)

  targetPlatform  String @map("target_platform")
  exportProfileId String @map("export_profile_id")

  // The FROZEN VideoRenderInputV1 (checkpoint §4). Persisted verbatim at
  // submission, never mutated. The renderer + Gate #4 + every QA check
  // read from this, not from live domain state.
  renderInputSnapshot  Json @map("render_input_snapshot")
  renderInputVersion   Int  @default(1) @map("render_input_version")

  // Freshness fences — Gate #4 currentness (checkpoint §14/§24). Each is
  // recomputed from live dependencies at Gate #4 evaluation and compared
  // to what the snapshot froze.
  scriptVersionHash      String  @map("script_version_hash")
  sceneAssetFingerprint  String  @map("scene_asset_fingerprint")
  voiceAudioAssetPublicId String @map("voice_audio_asset_public_id") @db.Uuid
  subtitleVttAssetPublicId String? @map("subtitle_vtt_asset_public_id") @db.Uuid

  // Produced artifact — set on COMPLETED. The VIDEO MediaAsset is the
  // authority for Gate #4, not this pointer.
  outputMediaAssetPublicId  String? @map("output_media_asset_public_id") @db.Uuid
  outputMediaAssetGroupId   String? @map("output_media_asset_group_id") @db.Uuid
  outputWidth               Int?    @map("output_width")
  outputHeight              Int?    @map("output_height")
  outputDurationMs          Int?    @map("output_duration_ms")
  outputFps                 Int?    @map("output_fps")
  outputByteSize            BigInt? @map("output_byte_size")
  outputChecksumSha256      String? @map("output_checksum_sha256")
  outputContainer           String? @map("output_container")
  outputVideoCodec          String? @map("output_video_codec")
  outputAudioCodec          String? @map("output_audio_codec")

  // Which engine actually rendered this (checkpoint §13/§32): "remotion"
  // in production, "deterministic-test" for automated tests.
  renderEngine        String? @map("render_engine")
  renderEngineVersion String? @map("render_engine_version")

  // FR-VID-007: renders resume rather than restart — this counts genuine
  // attempts against the retry budget.
  attempt Int @default(0)

  errorCode        String? @map("error_code")
  errorMessageSafe String? @map("error_message_safe")

  correlationId String @map("correlation_id")

  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")

  createdById String? @map("created_by") @db.Uuid
  createdBy   User?   @relation("VideoRenderJobCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([workspaceId])
  @@index([status])
  @@index([correlationId])
  @@index([contentItemId])
  @@map("video_render_jobs")
}

// Module 5 Phase 5.1 — Content Planner: Topic Cluster Planning
// (FR-PLAN-002). Implements DB Design §5.8's own frozen `keywords` /
// `keyword_clusters` / `keyword_cluster_members`, deliberately left
// unbuilt by Module 4 (no real downstream consumer existed yet — see
// v4.0.0-module-4-frozen's own tag message). topic_clusters is that
// real consumer: FR-PLAN-002's AC requires a cluster to link to real
// content_series/keyword_clusters rows, not an opaque JSONB blob.
//
// Everything here is a deterministic MATERIALIZATION of a completed
// Research run's own ai_jobs.output_payload.keywordClusters[] — never a
// second AI call, never a fabricated metric beyond what
// RESEARCH_AGENT_V1 (Module 4) already computed and persisted.
enum SearchIntent {
  INFORMATIONAL
  TRANSACTIONAL
  NAVIGATIONAL
  UNKNOWN
}

enum KeywordClusterMembership {
  PRIMARY
  SECONDARY
}

model Keyword {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  term             String
  searchIntent     SearchIntent @map("search_intent")
  opportunityScore Int          @map("opportunity_score")
  rationale        String

  createdAt DateTime @default(now()) @map("created_at")

  clusterMemberships KeywordClusterMember[]

  // A given term is materialized once per workspace — re-materializing
  // the same (or a different) Research run's output reuses the existing
  // row rather than duplicating it.
  @@unique([workspaceId, term])
  @@index([workspaceId])
  @@map("keywords")
}

// One row per Research run's own keywordClusters[] entry, materialized
// on demand — only when a user actually promotes it via topic_clusters,
// never speculatively on every Research completion.
model KeywordCluster {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  topic String

  // Exact provenance: the Research run and Knowledge Pack version this
  // cluster's own keyword intelligence actually came from — never
  // re-resolved to "latest," matching AiJob.knowledgePackId's own
  // execution-provenance guarantee.
  sourceAiJobId String @map("source_ai_job_id") @db.Uuid
  sourceAiJob   AiJob  @relation(fields: [sourceAiJobId], references: [id])

  knowledgePackId String        @map("knowledge_pack_id") @db.Uuid
  knowledgePack   KnowledgePack @relation(fields: [knowledgePackId, workspaceId], references: [id, workspaceId])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("KeywordClusterCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  members      KeywordClusterMember[]
  topicCluster TopicCluster?

  // Idempotent materialization: re-promoting the same Research run's
  // same cluster topic reuses the existing row instead of duplicating.
  @@unique([workspaceId, sourceAiJobId, topic])
  @@index([workspaceId])
  @@index([sourceAiJobId])
  @@map("keyword_clusters")
}

model KeywordClusterMember {
  id String @id @default(uuid()) @db.Uuid

  keywordClusterId String         @map("keyword_cluster_id") @db.Uuid
  keywordCluster   KeywordCluster @relation(fields: [keywordClusterId], references: [id])

  keywordId String  @map("keyword_id") @db.Uuid
  keyword   Keyword @relation(fields: [keywordId], references: [id])

  membership KeywordClusterMembership

  @@unique([keywordClusterId, keywordId])
  @@index([keywordClusterId])
  @@index([keywordId])
  @@map("keyword_cluster_members")
}

// FR-PLAN-002 — "workspace_id, name; links content_series and
// keyword_clusters." A deliberate human planning decision (promoting
// one Research-derived keyword cluster into an actual content-planning
// topic) — never AI-generated itself; every field here is either
// user-supplied or resolved server-side from the real KeywordCluster/
// ContentSeries rows it references. Never lets a caller invent a
// keywordClusterId/contentSeriesId that doesn't already exist in this
// same workspace (service-layer validation, not expressible as a single
// FK condition alone).
model TopicCluster {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name String

  // One topic cluster per keyword cluster — re-promoting the same
  // keyword cluster is rejected (409), never a silent duplicate.
  keywordClusterId String         @unique @map("keyword_cluster_id") @db.Uuid
  keywordCluster   KeywordCluster @relation(fields: [keywordClusterId], references: [id])

  // Workspace-safe composite FK, same pattern as ContentItem.seriesId —
  // optional: FR-PLAN-002's own AC only requires the link to exist once
  // populated, never that it's mandatory up front.
  contentSeriesId String?        @map("content_series_id") @db.Uuid
  contentSeries   ContentSeries? @relation(fields: [contentSeriesId, workspaceId], references: [id, workspaceId])

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("TopicClusterCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@index([contentSeriesId])
  @@map("topic_clusters")
}

// ---------------------------------------------------------------------------
// Module 6 Phase 6.1 — Content Scoring Engine (shared foundation).
//
// AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_V1.0.md §5.10 (content_scores) and
// §5.8 (seo_reports). Both are APPEND-ONLY score history: every scoring run
// inserts a new row; "current" score = newest by calculated_at. This
// matches CONTENT_SCORING_ENGINE_V1.0.md's Reporting ("Historical trend")
// and its Learning Loop ("evaluates every content asset before AND after
// publication") — a single mutable row could represent neither. Same
// append-only, no-soft-delete shape as content_review_events /
// keyword_clusters (DB Design §4: append-only rows carry created_at only).
// ---------------------------------------------------------------------------

model ContentScore {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FK — a score always belongs to a content
  // item in the SAME workspace (same pattern as ContentReviewEvent).
  contentItemId String      @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation(fields: [contentItemId, workspaceId], references: [id, workspaceId])

  // The frozen Overall Content Score (§5.10 `score`, 0–100) — the
  // equal-weight mean of the five universal category scores. The
  // content-type dimension score (e.g. "Blog Score") is NOT this value;
  // it lives inside `factors`.
  score Int @map("score")

  // §5.10 `factors (JSONB, explainability)` — the full ScoreResultJSON
  // from @myev/shared: category scores, the applied dimension + its own
  // score, every factor's contribution/weight/reason/evidence, and the
  // deterministically-derived improvement recommendations.
  factors Json @map("factors")

  // §5.10 `calculated_at` — when this scoring run executed. The ordering
  // key for "latest score".
  calculatedAt DateTime @default(now()) @map("calculated_at")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("ContentScoreCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([contentItemId])
  @@index([contentItemId, calculatedAt])
  @@map("content_scores")
}

model SeoReport {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  contentItemId String      @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation(fields: [contentItemId, workspaceId], references: [id, workspaceId])

  // §5.8 `seo_score (0–100)` — the SEO universal-category score for this
  // run, mirrored here so the SEO view is queryable without unpacking
  // `content_scores.factors`.
  seoScore Int @map("seo_score")

  // §5.8 `breakdown (JSONB, matches FR-SEO-003)` — the SeoBreakdownJSON
  // from @myev/shared: every SEO factor "individually retrievable, not
  // just the composite" (FR-SEO-003 AC), plus the SEO-scoped
  // recommendations.
  breakdown Json @map("breakdown")

  calculatedAt DateTime @default(now()) @map("calculated_at")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("SeoReportCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@index([contentItemId])
  @@index([contentItemId, calculatedAt])
  @@map("seo_reports")
}

// ---------------------------------------------------------------------------
// Module 6 Phase 6.2 — Blog Automation.
//
// AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_V1.0.md §5.4: "blog_articles (1:1
// extension where content_type = BLOG) — meta_title, meta_description,
// url_slug, schema_markup (JSONB)." A single mutable current row per BLOG
// content item (a type-specific extension, like the frozen video_scripts /
// newsletters / social_posts rows) — NOT append-only, so it carries
// created_at + updated_at and content_item_id is UNIQUE.
//
// Phase 6.2 adds the table/relations only. Nothing writes to it yet — the
// SEO Metadata Agent produces this metadata as an AiJob output; the write
// into blog_articles is Phase 6.3 orchestration.
// ---------------------------------------------------------------------------

model BlogArticle {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // 1:1 with a BLOG content item, in the SAME workspace — workspace-safe
  // composite FK, same pattern as ContentReviewEvent / ContentScore. The
  // content_type = BLOG constraint is a service-layer rule (Phase 6.3),
  // not expressible as a single FK.
  contentItemId String      @unique @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation(fields: [contentItemId, workspaceId], references: [id, workspaceId])

  metaTitle       String @map("meta_title")
  metaDescription String @map("meta_description")
  urlSlug         String @map("url_slug")
  // schema.org JSON-LD suggestion (FR-SEO-002 / DB Design §5.4 `schema_markup`).
  schemaMarkup Json @map("schema_markup")

  createdById String @map("created_by") @db.Uuid
  createdBy   User   @relation("BlogArticleCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by") @db.Uuid
  updatedBy   User?   @relation("BlogArticleUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // `contentItemId` alone is already @unique (the real 1:1 guarantee);
  // Prisma additionally requires the composite declared so it recognises
  // the to-one shape of the workspace-safe (contentItemId, workspaceId)
  // relation — same pattern as ContentItem.@@unique([currentVersionId, id]).
  @@unique([contentItemId, workspaceId])
  @@index([workspaceId])
  @@map("blog_articles")
}

// Module 7 Phase 7.1 — the 1:1 (content_type = VIDEO) extension row for
// the Video Automation pipeline. AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_
// V1.0.md §5.4 (`video_scripts`: script_body, scene_plan JSONB,
// voice_profile_id, render_job_id). Structurally identical to
// BlogArticle: workspace-safe composite FK, one row per VIDEO content
// item, created when the video pipeline is started.
//
// Only `targetPlatform` is populated at create time (FR-VID-001). Every
// other column is nullable and stays null until the phase that produces
// it: script_body / scene_plan (Phase 7.2 Script + Scene agents),
// meta_* / tags / chapters / hashtags / schema_markup (Phase 7.2/7.3 SEO
// step), voice_profile_id (Phase 7.4 Voice Engine), render_job_id
// (Phase 7.5 rendering).
//
// voice_profile_id and render_job_id are plain nullable UUID columns, NOT
// foreign keys — the voice_profiles table and the VideoRenderJob
// extension of background_jobs (checkpoint decision D5) are later-phase
// concerns, and adding the constraint now would force those tables to
// exist prematurely (checkpoint: "Prefer incremental schema evolution
// over creating all future tables early").
model VideoScript {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // 1:1 with a VIDEO content item, in the SAME workspace — workspace-safe
  // composite FK, same pattern as BlogArticle / ContentScore. The
  // content_type = VIDEO constraint is a service-layer rule (Phase 7.1),
  // not expressible as a single FK.
  contentItemId String      @unique @map("content_item_id") @db.Uuid
  contentItem   ContentItem @relation(fields: [contentItemId, workspaceId], references: [id, workspaceId])

  // FR-VID-001: required at pipeline-create time. The frozen "Supported
  // Outputs" list — see the VideoTargetPlatform enum.
  targetPlatform VideoTargetPlatform @map("target_platform")

  // Frozen Rendering Engine "Export profiles" — resolved during the
  // brief/script stage (Phase 7.2+). Free-form string, matched against
  // the target platform's spec at render time (FR-VID-007).
  exportProfile String? @map("export_profile")

  // FR-VID-001 brief output "Duration" — the target length in seconds.
  durationSecondsTarget Int? @map("duration_seconds_target")

  // FR-VID-002 Script Engine output.
  scriptBody String? @map("script_body")

  // FR-VID-003 Scene Planner output — scene timeline, visual
  // instructions, B-roll suggestions, transition plan. DB Design §5.4
  // `scene_plan` JSONB.
  scenePlan Json? @map("scene_plan")

  // DB Design §5.4 `voice_profile_id` — forward reference to the Voice
  // Engine (Phase 7.4). Plain nullable UUID, not a FK (see model comment).
  voiceProfileId String? @map("voice_profile_id") @db.Uuid

  // DB Design §5.4 `render_job_id` — forward reference to VideoRenderJob
  // (Phase 7.5, checkpoint D5). Plain nullable UUID, not a FK.
  renderJobId String? @map("render_job_id") @db.Uuid

  // FR-VID-009 / FR-SEO-001 video SEO metadata (Quality Gate #6) —
  // title / description / tags / chapters / hashtags — and FR-SEO-002
  // VideoObject schema. All nullable until the SEO stage (Phase 7.2/7.3).
  // Mirrors BlogArticle's meta_title / meta_description / schema_markup.
  metaTitle       String? @map("meta_title")
  metaDescription String? @map("meta_description")
  tags            Json?
  chapters        Json?
  hashtags        Json?
  schemaMarkup    Json?   @map("schema_markup")

  createdById String  @map("created_by") @db.Uuid
  createdBy   User    @relation("VideoScriptCreatedBy", fields: [createdById], references: [id])
  updatedById String? @map("updated_by") @db.Uuid
  updatedBy   User?   @relation("VideoScriptUpdatedBy", fields: [updatedById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // `contentItemId` alone is already @unique (the real 1:1 guarantee);
  // Prisma additionally requires the composite declared so it recognises
  // the to-one shape of the workspace-safe (contentItemId, workspaceId)
  // relation — same pattern as BlogArticle.@@unique([contentItemId, workspaceId]).
  @@unique([contentItemId, workspaceId])
  @@index([workspaceId])
  @@map("video_scripts")
}

// ---------------------------------------------------------------------------
// Module 8 Phase 8.1 — AI Internal Linking Engine: Domain + Persistence
// Foundation.
//
// AI_CONTENT_DATABASE_AND_ENTITY_DESIGN_V1.0.md Appendix G names
// `internal_links` as the frozen table for this feature — extended here
// with a full recommendation-lifecycle field set, the same relationship
// every other real Prisma model already has to its own minimal logical-
// schema-doc listing (see ContentScore/BlogArticle/VideoScript above).
//
// v1 scope is Blog -> Blog only (Module 8 Architecture Checkpoint
// Correction, corrected D2 — VideoScript has no stable linkable-URL
// concept today; BlogArticle.urlSlug does). Persistence itself stays
// content-item-generic (plain FKs to content_items, no Blog-specific
// column) so a future content type is a business-logic change to
// candidate discovery, not a schema redesign.
//
// This migration adds ONLY this table + two enum values on AuditAction +
// the two ContentItem back-relations + the one User back-relation above.
// No existing table is altered, dropped, or backfilled.
// ---------------------------------------------------------------------------

// GENERATED -> ACCEPTED | REJECTED | STALE; ACCEPTED -> STALE. REJECTED and
// STALE are both terminal for that row — a fresh recommendation for the
// same pair is always a NEW row, never a resurrection (see the partial
// unique index below, which deliberately excludes REJECTED/STALE from
// its uniqueness scope for exactly this reason).
enum InternalLinkStatus {
  GENERATED
  ACCEPTED
  REJECTED
  STALE
}

model InternalLink {
  id       String @id @default(uuid()) @db.Uuid
  publicId String @unique @default(uuid()) @map("public_id") @db.Uuid

  workspaceId String    @map("workspace_id") @db.Uuid
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  // Workspace-safe composite FKs — source and target must each belong to
  // the SAME workspace as this row (same pattern as ContentScore/
  // BlogArticle/VideoScript's own contentItemId relation). Two distinct
  // named relations onto the same target model, same pattern as
  // BlogArticle.createdBy/updatedBy both pointing at User.
  sourceContentItemId String      @map("source_content_item_id") @db.Uuid
  sourceContentItem   ContentItem @relation("InternalLinkSource", fields: [sourceContentItemId, workspaceId], references: [id, workspaceId])
  targetContentItemId String      @map("target_content_item_id") @db.Uuid
  targetContentItem   ContentItem @relation("InternalLinkTarget", fields: [targetContentItemId, workspaceId], references: [id, workspaceId])

  anchorText     String @map("anchor_text")
  // 0-100, enforced at the domain layer (assertValidRelevanceScore) —
  // Postgres CHECK constraints are deliberately not used anywhere else in
  // this schema, so none is introduced here either.
  relevanceScore Int    @map("relevance_score")
  // Structured per-factor breakdown (topic-cluster proximity, keyword
  // overlap, freshness, authority, anchor fit, density/duplicate
  // penalties — Module 8 Architecture Checkpoint §9). Populated by the
  // Phase 8.2 discovery engine; opaque to Phase 8.1.
  evidence Json

  status InternalLinkStatus @default(GENERATED)

  // Bumped only if Module 8's own scoring/discovery logic changes in a
  // way that should be visible per-row without retroactively touching
  // history (Architecture Checkpoint D14) — a plain version stamp, not a
  // FK to anything.
  engineVersion Int      @default(1) @map("engine_version")
  generatedAt   DateTime @default(now()) @map("generated_at")

  reviewedById String?   @map("reviewed_by") @db.Uuid
  reviewedBy   User?     @relation("InternalLinkReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime? @map("reviewed_at")

  rejectionReason String? @map("rejection_reason")
  staleReason     String? @map("stale_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // The partial-unique invariant (at most one live GENERATED/ACCEPTED row
  // per pair — REJECTED/STALE rows are history, not "live") is a hand-
  // written raw-SQL index in the migration, not expressible in Prisma's
  // schema DSL (same precedent as KnowledgePack's own "at most one ACTIVE
  // per lineage root" partial unique index) — see migration.sql.
  @@index([workspaceId, sourceContentItemId, status])
  @@index([workspaceId, targetContentItemId, status])
  @@map("internal_links")
}
