# Copy to .env for local development. Never commit the real .env.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Points at the Docker Compose "postgres" service on the internal network —
# not a host-exposed port. See docker/docker-compose.yml.
DATABASE_URL=postgresql://myev:myev_dev_password@postgres:5432/myev_media?schema=public

REDIS_URL=redis://redis:6379

STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=myev_minio_admin
STORAGE_SECRET_KEY=myev_minio_dev_password
STORAGE_BUCKET=myev-media-dev

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_ADDRESS=no-reply@myevmedia.com
APP_URL=http://localhost:3100

# Never use this dev secret outside a local compose stack.
JWT_ACCESS_SECRET=dev-only-jwt-secret-do-not-use-in-production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_FAMILY_TTL_SECONDS=2592000
FAILED_LOGIN_THRESHOLD=5
LOCK_WINDOW_SECONDS=900
RESET_TOKEN_TTL_SECONDS=3600
ACTIVATION_TOKEN_TTL_SECONDS=604800
PASSWORD_HISTORY_LIMIT=5

# Bootstrap owner — only used by `pnpm prisma:seed`. Also the single,
# global Platform Owner (Module 1C) — the only account permitted to create
# a workspace in V1. Serialized bootstrap: see platform-owner.seed.ts.
BOOTSTRAP_OWNER_EMAIL=owner@myevmedia.com
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Platform Owner

# Module 1C: Workspace Foundation
WORKSPACE_INVITATION_TTL_SECONDS=604800
# Platform-configurable workspace defaults (Module 1C Engineering Plan
# §2.F′) — never hardcoded in application logic. Applied at workspace
# creation unless the request supplies a valid override.
PLATFORM_DEFAULT_TIMEZONE=UTC
PLATFORM_DEFAULT_LOCALE=en-US
PLATFORM_DEFAULT_CURRENCY=USD
PLATFORM_DEFAULT_DATE_FORMAT=YYYY-MM-DD
# Activation-resend rate limits (Module 1C Engineering Plan §3) — two
# independent dimensions, per-user and per-initiating-workspace.
RESEND_ACTIVATION_PER_USER_LIMIT=5
RESEND_ACTIVATION_PER_USER_WINDOW_SECONDS=3600
RESEND_ACTIVATION_PER_WORKSPACE_LIMIT=10
RESEND_ACTIVATION_PER_WORKSPACE_WINDOW_SECONDS=3600

# Module 1D: Media Asset Foundation
# Which real service the STORAGE_* credentials above point at right now —
# stamped onto every media_assets row created while this is active. See
# MODULE 1D ENGINEERING PLAN §7.
STORAGE_PROVIDER_IDENTITY=MINIO
# FRD §21.1 per-asset-type ceilings (frozen requirement, unchanged).
MEDIA_MAX_SIZE_IMAGE_BYTES=26214400
MEDIA_MAX_SIZE_AUDIO_BYTES=104857600
MEDIA_MAX_SIZE_VIDEO_BYTES=2147483648
MEDIA_MAX_SIZE_DOCUMENT_BYTES=20971520
# ACR approved 2026-08-06: Module 1D's synchronous verification ceiling.
# Effective per-type max is min(FRD max, this) — only VIDEO is affected.
# Full 2GB VIDEO support is deferred until Queue Engine provides
# asynchronous verification.
MEDIA_SYNC_CHECKSUM_MAX_BYTES=524288000
MEDIA_MIME_INSPECTION_BYTES=4096
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
MEDIA_VERIFICATION_STALE_AFTER_SECONDS=600
MEDIA_STORAGE_OPERATION_TIMEOUT_SECONDS=10
MEDIA_CHECKSUM_TIMEOUT_SECONDS=120
MEDIA_MAX_VERIFICATION_DURATION_SECONDS=180
MEDIA_UPLOAD_INTENT_RATE_LIMIT=30
MEDIA_UPLOAD_INTENT_RATE_WINDOW_SECONDS=3600
MEDIA_DOWNLOAD_URL_RATE_LIMIT=120
MEDIA_DOWNLOAD_URL_RATE_WINDOW_SECONDS=3600
MEDIA_RETRY_VERIFICATION_RATE_LIMIT=10
MEDIA_RETRY_VERIFICATION_RATE_WINDOW_SECONDS=3600

# Module 1E: Content Foundation — Body Validation Contract. No frozen FRD
# figure exists for these; reasonable, documented ceilings rather than
# unbounded input.
CONTENT_MAX_BODY_SIZE_BYTES=2000000
CONTENT_MAX_BODY_DEPTH=10
CONTENT_MAX_STRING_VALUE_LENGTH=200000
CONTENT_BASE64_HEURISTIC_MIN_LENGTH=512
# Review Comment Limit — Module 1E Engineering Plan final approval round.
# Mirrored by the content_review_events_comment_check DB constraint.
CONTENT_REVIEW_COMMENT_MAX_LENGTH=2000

# Module 3 Phase 3.4: AI Provider Runtime Wiring. Leave an apiKey empty to
# leave that provider unconfigured — it will not be registered, and an
# agent that selects it fails cleanly with a normalized PROVIDER_ERROR
# rather than crashing this process. Never commit a real key here.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Module 9 Phase 9.1: Publishing credential envelope encryption. A
# 64-character hex string (32 random bytes), e.g. `openssl rand -hex 32`.
# Leave empty in any environment that never persists a ChannelCredential —
# PublishingCredentialCryptoService validates this lazily inside its own
# encrypt()/decrypt() calls, never at startup. Never commit a real key here.
PUBLISHING_CREDENTIAL_ENCRYPTION_KEY=
